# Never commit real credentials. Copy this file to .env or export values via your service manager.
CLICKUP_TOKEN=replace-me
CLICKUP_SPACE_ID=replace-me
CLICKUP_FOLDER_NAME=Hermes

# Hermes dashboard/plugin API. Loopback is strongly recommended.
HERMES_BASE_URL=http://127.0.0.1:9119
# Optional. Only required when your Hermes API expects the dashboard session header.
HERMES_SESSION_TOKEN=

POLL_INTERVAL_SECONDS=30
SYNC_STATE_DB=./data/sync.db

# Values must match statuses configured in the ClickUp Folder/Lists.
# Override only the entries you need.
STATUS_MAP_JSON={"triage":"TRIAGE","todo":"TODO","scheduled":"SCHEDULED","ready":"READY","running":"RUNNING","blocked":"BLOCKED","review":"REVIEW","done":"DONE","archived":"ARCHIVED"}
